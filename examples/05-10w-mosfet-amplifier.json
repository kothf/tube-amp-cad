  {
   "id": "c43_9076",
   "type": "note",
   "x": 100,
   "y": 930,
   "rot": 0,
   "params": {
    "text": "Source: homemade-circuits.com, 'Simple 10 watt amplifier circuits explained', fig. 1 (true complementary MOSFET output).",
    "size": "10"
   },
   "label": ""
  },
  {
   "id": "c44_6444",
   "type": "note",
   "x": 100,
   "y": 950,
   "rot": 0,
   "params": {
    "text": "Article: gain ~ R6/R5 = 10 (20 dB); R8 set for ~30 mA quiescent; ~30 V loaded supply gives 6-7 W RMS into 8 ohm, 36 V about 10 W;",
    "size": "10"
   },
   "label": ""
  },
  {
   "id": "c45_8612",
   "type": "note",
   "x": 100,
   "y": 970,
   "rot": 0,
   "params": {
    "text": "distortion below 0.1 % at all levels. R8 is the bias preset (wiper tied to one end); its slider sets the quiescent current.",
    "size": "10"
   },
   "label": ""
  },
  {
   "id": "c46_7310",
   "type": "note",
   "x": 100,
   "y": 990,
   "rot": 0,
   "params": {
    "text": "R9 (680 ohm) feeds the bootstrap C5. A diode in its place would charge C5 to the output's negative peaks and raise the bias under signal until both MOSFETs pass about 4 A.",
    "size": "10"
   },
   "label": ""
  }
 ],
