   },
   "label": ""
  },
  {
   "id": "c22_4218",
   "type": "note",
   "x": 100,
   "y": 605,
   "rot": 0,
   "params": {
    "text": "f = 1.44 / ((R1 + 2 R2) C1) = 1.53 Hz, duty cycle 50.05 %: the LED is on and off for about 0.33 s each (about 6 mA through R3).",
